<launch>
  <!-- Define default values for parameters -->
  <arg name="subscribe_topics" default="['/camera_1/image_raw', '/camera_2/image_compress']"/>
  <arg name="video_resolutions" default="['1920*1080', '1920*1080']"/>
  
  <node pkg="coencoder" exec="coencoder" name="coencoder" output="screen" respawn="false">
    <param name="output_fps" value="20"/>
    <param name="bitrate" value="400000"/>
    <param name="depth_image_max_value" value="10000"/>
    <param name="subscribe_topics" value="$(var subscribe_topics)"/>
    <param name="video_resolutions" value="$(var video_resolutions)"/>
  </node>
</launch>
